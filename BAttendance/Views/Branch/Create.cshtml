@model BAttendance.Models.BranchViewModel

@{
    ViewData["Title"] = "Add Branch";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>




<form asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" id="validationSummary" style="display:none;"></div>

    <div class="branch-form-grid">
        <div class="panel-card">
            <div class="panel-body p-3 p-md-4">
                
                <!-- 1. Branch Details -->
                <div class="panel-section-title mb-2"><i class="bi bi-building"></i> Branch Details</div>
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label asp-for="BranchName" class="form-label small fw-semibold"></label>
                        <input asp-for="BranchName" class="form-control form-control-sm" />
                        <span asp-validation-for="BranchName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label small fw-semibold"></label>
                        <input asp-for="Address" class="form-control form-control-sm" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-3 text-muted" />

                <!-- 2. Operating Schedule (Compact Grid) -->
                <div class="panel-section-title mb-2"><i class="bi bi-clock"></i> Weekly Schedule</div>
                <div class="row g-1 mb-3">
                    @{
                        var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
                    }
                    @foreach (var day in days)
                    {
                        var isProp = "Is" + day;
                        var openProp = day == "Thursday" ? "OpeningTimeThursda" : "OpeningTime" + day;
                        var closeProp = day == "Thursday" ? "ClosingTimeThursda" : "ClosingTime" + day;

                        var isChecked = Model.GetType().GetProperty(isProp)?.GetValue(Model)?.ToString() == "Y";
                        var openValObj = Model.GetType().GetProperty(openProp)?.GetValue(Model);
                        var closeValObj = Model.GetType().GetProperty(closeProp)?.GetValue(Model);

                        var openVal = openValObj is TimeSpan openSpan ? openSpan.ToString(@"hh\:mm") : "08:00";
                        var closeVal = closeValObj is TimeSpan closeSpan ? closeSpan.ToString(@"hh\:mm") : "17:00";

                        <div class="col-12 schedule-row py-1 border-bottom border-light">
                            <div class="row align-items-center g-1">
                                <div class="col-3 col-md-3">
                                    <input type="hidden" name="@isProp" value="N" />
                                    <div class="form-check mb-0">
                                        <input class="form-check-input form-check-input-sm" type="checkbox" name="@isProp" value="Y" id="@isProp" @(isChecked ? "checked" : "")>
                                        <label class="form-check-label small fw-semibold" for="@isProp">@day.Substring(0, 3)</label>
                                    </div>
                                </div>
                                <div class="col-4 col-md-4">
                                    <input type="time" name="@openProp" class="form-control form-control-sm py-0 px-1" value="@openVal" />
                                </div>
                                <div class="col-1 text-center text-muted px-0 small">-</div>
                                <div class="col-4 col-md-4">
                                    <input type="time" name="@closeProp" class="form-control form-control-sm py-0 px-1" value="@closeVal" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <hr class="my-3 text-muted" />

                <!-- 3. Location & Rules Side-by-Side -->
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="panel-section-title mb-0"><i class="bi bi-geo-alt"></i> Location & Rules</div>
                    <button type="button" class="locate-btn btn btn-outline-secondary btn-sm py-0 px-2" id="btnUseLocation">
                        <i class="bi bi-crosshair"></i> Detect
                    </button>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Latitude" class="form-label small fw-semibold"></label>
                        <input asp-for="Latitude" class="form-control form-control-sm" id="latitudeInput" />
                        <span asp-validation-for="Latitude" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Longitude" class="form-label small fw-semibold"></label>
                        <input asp-for="Longitude" class="form-control form-control-sm" id="longitudeInput" />
                        <span asp-validation-for="Longitude" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label asp-for="AllowedRadiusMeters" class="form-label small fw-semibold"></label>
                        <input asp-for="AllowedRadiusMeters" type="number" class="form-control form-control-sm" id="radiusInput" />
                        <span asp-validation-for="AllowedRadiusMeters" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 d-flex flex-column justify-content-end">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" asp-for="IsIpRestrictionEnabled" id="chkIpRestriction" />
                            <label class="form-check-label small fw-semibold" asp-for="IsIpRestrictionEnabled">Restrict WiFi IP</label>
                        </div>
                    </div>
                </div>

                <!-- Conditional IP Address Input Field -->
                <div class="mb-3 p-2 bg-light rounded border" id="ipAddressContainer" style="display: none;">
                    <label asp-for="CompanyPublicIP" class="form-label small fw-semibold"></label>
                    <input asp-for="CompanyPublicIP" class="form-control form-control-sm" placeholder="e.g. 203.0.113.195" id="companyIpInput" />
                    <span asp-validation-for="CompanyPublicIP" class="text-danger small"></span>
                    <div class="form-text text-muted" style="font-size: 0.75rem;">Required public IP for check-in.</div>
                </div>

                <div class="form-actions mt-3">
                    <button type="submit" class="btn btn-primary btn-brand w-100 btn-sm py-2">Save Branch Configuration</button>
                </div>
            </div>
        </div>

        <!-- Sticky Map (Compact Height) -->
        <div class="map-sticky">
            <div class="panel-card">
                <div id="mapPreview" style="height: 220px; background: #eee;"></div>
                <div class="p-2 small">
                    <div class="coords-readout mb-1"><span class="label text-muted">Lat:</span><span class="value float-end fw-bold" id="readoutLat">—</span></div>
                    <div class="coords-readout"><span class="label text-muted">Lng:</span><span class="value float-end fw-bold" id="readoutLng">—</span></div>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var latInput = document.getElementById('latitudeInput'),
                lngInput = document.getElementById('longitudeInput'),
                readoutLat = document.getElementById('readoutLat'),
                readoutLng = document.getElementById('readoutLng'),
                btnLocate = document.getElementById('btnUseLocation');

            var initialLat = parseFloat(latInput.value) || 11.5564;
            var initialLng = parseFloat(lngInput.value) || 104.9282;

            var map = L.map('mapPreview').setView([initialLat, initialLng], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            var marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

            readoutLat.textContent = initialLat.toFixed(6);
            readoutLng.textContent = initialLng.toFixed(6);

            function updateFields(lat, lng) {
                latInput.value = lat.toFixed(6);
                lngInput.value = lng.toFixed(6);
                readoutLat.textContent = lat.toFixed(6);
                readoutLng.textContent = lng.toFixed(6);
                marker.setLatLng([lat, lng]);
                map.setView([lat, lng], 16);
            }

            marker.on('dragend', (e) => { var p = e.target.getLatLng(); updateFields(p.lat, p.lng); });
            map.on('click', (e) => { updateFields(e.latlng.lat, e.latlng.lng); });

            latInput.addEventListener('change', () => {
                var lat = parseFloat(latInput.value), lng = parseFloat(lngInput.value);
                if (!isNaN(lat) && !isNaN(lng)) updateFields(lat, lng);
            });
            lngInput.addEventListener('change', () => {
                var lat = parseFloat(latInput.value), lng = parseFloat(lngInput.value);
                if (!isNaN(lat) && !isNaN(lng)) updateFields(lat, lng);
            });

            btnLocate.addEventListener('click', () => {
                if (!navigator.geolocation) { alert("Geolocation not supported."); return; }
                navigator.geolocation.getCurrentPosition(
                    (pos) => updateFields(pos.coords.latitude, pos.coords.longitude),
                    () => alert("Location access denied.")
                );
            });

            // Toggle Company Public IP input visibility
            var chkIpRestriction = document.getElementById('chkIpRestriction');
            var ipAddressContainer = document.getElementById('ipAddressContainer');
            var companyIpInput = document.getElementById('companyIpInput');

            function toggleIpContainer() {
                if (chkIpRestriction.checked) {
                    ipAddressContainer.style.display = 'block';
                } else {
                    ipAddressContainer.style.display = 'none';
                    companyIpInput.value = '';
                }
            }

            toggleIpContainer();
            chkIpRestriction.addEventListener('change', toggleIpContainer);
        })();
    </script>
}