@model BAttendance.Models.UserViewModel

@{
    ViewData["Title"] = "Edit System User";
}

<div class="container-fluid py-4" style="max-width: 1200px; margin: 0 auto;">

    <!-- Header & Back Link -->
    <div class="mb-4">
        <a asp-action="UserList" class="text-decoration-none text-muted small fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Back to User List
        </a>
        <h4 class="m-0 mt-2 fw-bold text-dark"><i class="bi bi-person-gear text-primary me-2"></i>Edit System User</h4>
        <p class="text-muted small m-0 mt-1">Update user account credentials, roles, and attendance security policies.</p>
    </div>

    <!-- Alert Box for Errors -->
    <div id="formAlert" class="alert alert-danger py-2 small shadow-sm mb-4" style="display: none;"></div>

    <form id="userForm" asp-action="CreateUser" method="post" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="mode" value="Update" />

        <div class="row g-4">
            <!-- Left Column: Account Credentials -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom"><i class="bi bi-info-circle me-2"></i>Account Information</h6>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Usercode" class="form-label fw-semibold small">Usercode</label>
                                <input asp-for="Usercode" class="form-control bg-light" readonly />
                                <div class="form-text small text-muted">Usercode cannot be changed.</div>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label fw-semibold small">Username</label>
                                <input asp-for="Username" class="form-control shadow-sm" required />
                                <div class="field-error text-danger small mt-1" data-field="Username"></div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold small">Email Address</label>
                                <input asp-for="Email" type="email" class="form-control shadow-sm" required />
                                <div class="field-error text-danger small mt-1" data-field="Email"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold small">Password <span class="text-muted fw-normal">(Leave blank to keep existing)</span></label>
                                <input name="password" type="password" class="form-control shadow-sm" placeholder="••••••••" />
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label asp-for="Role" class="form-label fw-semibold small">Role</label>
                                <select asp-for="Role" class="form-select shadow-sm">
                                    <option value="Admin">Admin</option>
                                    <option value="Manager">Manager</option>
                                    <option value="Staff">Staff</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label fw-semibold small">Status</label>
                                <select asp-for="Status" class="form-select shadow-sm">
                                    <option value="active">Active</option>
                                    <option value="inactive">Inactive</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="IsLicense" class="form-label fw-semibold small">License Status</label>
                                <select asp-for="IsLicense" class="form-select shadow-sm">
                                    <option value="N">No (N)</option>
                                    <option value="Y">Yes (Y)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StaffId" class="form-label fw-semibold small">Link to Staff ID</label>
                            <input asp-for="StaffId" class="form-control shadow-sm" placeholder="Optional staff identifier" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Security Policies -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-3 mb-3">
                    <div class="card-body p-4">
                        <h6 class="fw-bold text-dark mb-3 pb-2 border-bottom"><i class="bi bi-shield-lock me-2"></i>Security Policies</h6>
                        <p class="text-muted small mb-4">Configure mandatory attendance validation flags for this user account.</p>

                        <div class="d-flex flex-column gap-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="RequireGpsLocation" id="chkGps" role="switch" />
                                <label class="form-check-label fw-semibold small text-dark" asp-for="RequireGpsLocation">Require GPS Location</label>
                            </div>

                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="RequireFaceScan" id="chkFaceScan" role="switch" />
                                <label class="form-check-label fw-semibold small text-dark" asp-for="RequireFaceScan">Require Face Scan</label>
                            </div>

                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="RequirePublicIp" id="chkPublicIp" role="switch" />
                                <label class="form-check-label fw-semibold small text-dark" asp-for="RequirePublicIp">Require Public IP</label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons Card -->
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-3 text-end d-flex gap-2 justify-content-end">
                        <a asp-action="UserList" class="btn btn-outline-secondary btn-sm px-4 shadow-sm">Cancel</a>
                        <button type="submit" id="submitBtn" class="btn btn-primary btn-sm px-4 shadow-sm" style="background: var(--brand, #1B2430);">
                            <i class="bi bi-check-lg me-1"></i> Save Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('userForm');
            var alertBox = document.getElementById('formAlert');
            var submitBtn = document.getElementById('submitBtn');

            function clearErrors() {
                alertBox.style.display = 'none';
                alertBox.textContent = '';
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                clearErrors();

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Saving...';

                var formData = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data.success) {
                        window.location.href = '@Url.Action("UserList", "User")';
                    } else {
                        alertBox.textContent = data.message || 'Operation failed. Please check your inputs.';
                        alertBox.style.display = 'block';
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                })
                .catch(function () {
                    alertBox.textContent = 'Network error occurred. Please try again.';
                    alertBox.style.display = 'block';
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                })
                .finally(function () {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i> Save Changes';
                });
            });
        })();
    </script>
}