@{
    ViewData["Title"] = "Dashboard";

    // TODO: replace with real values from your controller's model, e.g.
    // @model DashboardViewModel
    var totalStaff = 42;
    var checkedInToday = 31;
    var totalBranches = 4;
    var lateToday = 5;
}

<style>
    .kpi-card {
        background: #fff;
        border: 1px solid #E5E9EF;
        border-radius: 10px;
        padding: 1.25rem 1.4rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        height: 100%;
    }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        flex-shrink: 0;
    }

        .kpi-icon.brand {
            background: rgba(43, 58, 103, 0.1);
            color: var(--brand);
        }

        .kpi-icon.accent {
            background: rgba(46, 196, 182, 0.14);
            color: #17998d;
        }

        .kpi-icon.warn {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        .kpi-icon.neutral {
            background: rgba(139, 147, 161, 0.14);
            color: var(--text-muted);
        }

    .kpi-value {
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .kpi-label {
        color: var(--text-muted);
        font-size: 0.82rem;
    }

    .panel {
        background: #fff;
        border: 1px solid #E5E9EF;
        border-radius: 10px;
        padding: 1.4rem;
    }

    .panel-title {
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 1rem;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 0.4rem;
    }

        .status-dot.in {
            background: var(--accent);
        }

        .status-dot.out {
            background: var(--text-muted);
        }

        .status-dot.late {
            background: #dc3545;
        }

    .table-clean thead th {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--text-muted);
        border-bottom: 1px solid #E5E9EF;
        font-weight: 600;
        padding-bottom: 0.6rem;
    }

    .table-clean td {
        padding: 0.65rem 0.5rem;
        vertical-align: middle;
        border-bottom: 1px solid #F0F2F5;
        font-size: 0.88rem;
    }

    .avatar-sm {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: var(--brand);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.72rem;
        font-weight: 600;
        margin-right: 0.6rem;
    }

    .branch-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.65rem 0;
        border-bottom: 1px solid #F0F2F5;
    }

        .branch-row:last-child {
            border-bottom: none;
        }
</style>

<!-- KPI cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon brand"><i class="bi bi-people"></i></div>
            <div>
                <div class="kpi-value">@totalStaff</div>
                <div class="kpi-label">Total Staff</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon accent"><i class="bi bi-check-circle"></i></div>
            <div>
                <div class="kpi-value">@checkedInToday</div>
                <div class="kpi-label">Checked In Today</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon warn"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <div class="kpi-value">@lateToday</div>
                <div class="kpi-label">Late Today</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="kpi-card">
            <div class="kpi-icon neutral"><i class="bi bi-building"></i></div>
            <div>
                <div class="kpi-value">@totalBranches</div>
                <div class="kpi-label">Branches</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Recent attendance -->
    <div class="col-lg-8">
        <div class="panel">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="panel-title mb-0">Recent Attendance</div>
                <a asp-controller="Attendance" asp-action="Index" class="small text-decoration-none">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-clean mb-0">
                    <thead>
                        <tr>
                            <th>Staff</th>
                            <th>Branch</th>
                            <th>Type</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="avatar-sm">SK</span>Sok Kim</td>
                            <td>Phnom Penh HQ</td>
                            <td><span class="status-dot in"></span>Check In</td>
                            <td>08:02 AM</td>
                            <td><span class="badge text-bg-success-subtle text-success">Approved</span></td>
                        </tr>
                        <tr>
                            <td><span class="avatar-sm">DP</span>Dara Phen</td>
                            <td>Toul Kork Branch</td>
                            <td><span class="status-dot late"></span>Check In</td>
                            <td>09:15 AM</td>
                            <td><span class="badge text-bg-danger-subtle text-danger">Late</span></td>
                        </tr>
                        <tr>
                            <td><span class="avatar-sm">CN</span>Chan Nita</td>
                            <td>Phnom Penh HQ</td>
                            <td><span class="status-dot out"></span>Check Out</td>
                            <td>06:04 PM</td>
                            <td><span class="badge text-bg-success-subtle text-success">Approved</span></td>
                        </tr>
                        <tr>
                            <td><span class="avatar-sm">VR</span>Vanna Ry</td>
                            <td>Siem Reap Branch</td>
                            <td><span class="status-dot in"></span>Check In</td>
                            <td>08:47 AM</td>
                            <td><span class="badge text-bg-warning-subtle text-warning">Rejected</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Branch breakdown -->
    <div class="col-lg-4">
        <div class="panel">
            <div class="panel-title">Branches Today</div>

            <div class="branch-row">
                <span>Phnom Penh HQ</span>
                <span class="text-muted small">14 / 18 in</span>
            </div>
            <div class="branch-row">
                <span>Toul Kork Branch</span>
                <span class="text-muted small">8 / 10 in</span>
            </div>
            <div class="branch-row">
                <span>Siem Reap Branch</span>
                <span class="text-muted small">6 / 8 in</span>
            </div>
            <div class="branch-row">
                <span>Sihanoukville Branch</span>
                <span class="text-muted small">3 / 6 in</span>
            </div>
        </div>
    </div>
</div>
