@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BAttendance</title>

    <link rel="icon" type="image/x-icon" href="~/logo/CoreOneLogo.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/Picture/BSoftLogo.PNG" />

    <style>
        :root {
            --brand: #2B3A67;
            --brand-dark: #1B2430;
            --accent: #2EC4B6;
            --text-muted: #8B93A1;
        }

        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        .login-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* ---------- Left brand panel ---------- */
        .login-brand {
            flex: 1;
            position: relative;
            background: linear-gradient(155deg, var(--brand-dark) 0%, var(--brand) 100%);
            display: none;
            flex-direction: column;
            justify-content: space-between;
            padding: 3rem;
            color: #fff;
            overflow: hidden;
        }

            .login-brand::before {
                content: "";
                position: absolute;
                width: 480px;
                height: 480px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,0.08);
                top: -120px;
                right: -160px;
            }

            .login-brand::after {
                content: "";
                position: absolute;
                width: 320px;
                height: 320px;
                border-radius: 50%;
                border: 1px solid rgba(255,255,255,0.08);
                bottom: -100px;
                left: -80px;
            }

        .brand-top {
            display: flex;
            align-items: center;
            gap: 0.7rem;
            font-weight: 700;
            font-size: 1.15rem;
            position: relative;
            z-index: 1;
        }

            .brand-top .brand-dot {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: var(--accent);
                box-shadow: 0 0 0 4px rgba(46, 196, 182, 0.25);
            }

        .brand-message {
            position: relative;
            z-index: 1;
            max-width: 380px;
        }

            .brand-message h1 {
                font-size: 2rem;
                font-weight: 800;
                line-height: 1.25;
                margin-bottom: 0.9rem;
            }

            .brand-message p {
                color: rgba(255,255,255,0.72);
                font-size: 0.95rem;
                line-height: 1.6;
            }

        .brand-stats {
            display: flex;
            gap: 2rem;
            position: relative;
            z-index: 1;
        }

            .brand-stats .stat-value {
                font-size: 1.4rem;
                font-weight: 700;
            }

            .brand-stats .stat-label {
                font-size: 0.78rem;
                color: rgba(255,255,255,0.6);
            }

        /* ---------- Right form panel ---------- */
        .login-form-panel {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #F5F7FA;
            padding: 2rem;
        }

        .form-wrapper {
            width: 100%;
            max-width: 380px;
        }

        .mobile-brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.6rem;
            font-weight: 700;
            font-size: 1.2rem;
            color: var(--brand);
            margin-bottom: 2rem;
        }

            .mobile-brand .brand-dot {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: var(--accent);
            }

        .welcome-heading {
            font-size: 1.4rem;
            font-weight: 700;
            margin-bottom: 0.3rem;
            color: #1F2937;
        }

        .welcome-sub {
            color: var(--text-muted);
            font-size: 0.88rem;
            margin-bottom: 1.75rem;
        }

        .field-group {
            margin-bottom: 1.1rem;
        }

            .field-group label {
                font-size: 0.83rem;
                font-weight: 500;
                color: #1F2937;
                margin-bottom: 0.35rem;
                display: block;
            }

        .input-with-icon {
            position: relative;
        }

            .input-with-icon i.leading {
                position: absolute;
                left: 0.9rem;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 0.95rem;
            }

            .input-with-icon .form-control {
                padding-left: 2.5rem;
            }

        .form-control {
            border-radius: 8px;
            padding: 0.7rem 0.9rem;
            border: 1px solid #DDE2E9;
            font-size: 0.92rem;
        }

            .form-control:focus {
                border-color: var(--accent);
                box-shadow: 0 0 0 0.2rem rgba(46, 196, 182, 0.15);
            }

        .toggle-password {
            position: absolute;
            right: 0.9rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-muted);
            padding: 0;
            font-size: 0.95rem;
        }

            .toggle-password:hover {
                color: var(--brand);
            }

        .row-between {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.4rem;
        }

        .form-check-label {
            font-size: 0.85rem;
            color: #555;
        }

        .form-check-input:checked {
            background-color: var(--brand);
            border-color: var(--brand);
        }

        .forgot-link {
            font-size: 0.83rem;
            color: var(--brand);
            text-decoration: none;
            font-weight: 500;
        }

            .forgot-link:hover {
                text-decoration: underline;
            }

        .btn-login {
            border-radius: 8px;
            padding: 0.75rem;
            font-weight: 600;
            font-size: 0.92rem;
            background-color: var(--brand);
            color: #fff;
            border: none;
            width: 100%;
            transition: background-color 0.15s ease;
        }

            .btn-login:hover {
                background-color: #232f57;
            }

            .btn-login:disabled {
                opacity: 0.7;
            }

        .alert {
            border-radius: 8px;
            font-size: 0.85rem;
            padding: 0.7rem 0.9rem;
        }

        .login-footnote {
            text-align: center;
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-top: 1.75rem;
        }

    </style>
</head>
<body>
    <div class="login-container">
        <!-- Left brand panel -->
        <div class="login-brand">
            <div class="brand-top">
                <span class="brand-dot"></span> BAttendance
            </div>

            <div class="brand-message">
                <h1>Know who's in, the moment they arrive.</h1>
                <p>Face-verified, location-confirmed attendance across every branch — no buddy punching, no guesswork.</p>
            </div>

            <div class="brand-stats">
                <div>
                    <div class="stat-value">Multi-branch</div>
                    <div class="stat-label">Built for growing teams</div>
                </div>
                <div>
                    <div class="stat-value">Real-time</div>
                    <div class="stat-label">Live attendance status</div>
                </div>
            </div>
        </div>

        <!-- Right login form -->
        <div class="login-form-panel">
            <div class="form-wrapper">
                <div class="mobile-brand">
                    <span class="brand-dot"></span> BAttendance
                </div>

                <div class="welcome-heading">Welcome back</div>
                <div class="welcome-sub">Sign in to manage your branches and staff attendance.</div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                }

                <form method="post" asp-action="Index">
                    <div class="field-group">
                        <label for="username">Username</label>
                        <div class="input-with-icon">
                            <i class="bi bi-person leading"></i>
                            <input type="text" class="form-control" id="username" name="username" placeholder="Enter your username" required autofocus />
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="password">Password</label>
                        <div class="input-with-icon">
                            <i class="bi bi-lock leading"></i>
                            <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required />
                            <button type="button" class="toggle-password" id="togglePassword" aria-label="Show password">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="row-between">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="RememberMe" name="rememberMe" />
                            <label class="form-check-label" for="RememberMe">Remember me</label>
                        </div>
                        <a href="#" class="forgot-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn-login">Sign In</button>
                </form>

                <div class="login-footnote">&copy; 2026 BAttendance. All rights reserved.</div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var toggleBtn = document.getElementById('togglePassword');
        var passwordInput = document.getElementById('password');
        toggleBtn.addEventListener('click', function () {
            var isHidden = passwordInput.type === 'password';
            passwordInput.type = isHidden ? 'text' : 'password';
            toggleBtn.innerHTML = isHidden ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
        });

        @if (TempData["SuccessMessage"] != null)
        {
                <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["SuccessMessage"]',
                        timer: 2000,
                        showConfirmButton: false
                    });
                </text>
        }
    </script>
</body>
</html>
