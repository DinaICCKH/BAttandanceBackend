@model IEnumerable<BAttendance.Models.StaffViewModel>

@{
    ViewData["Title"] = "Staff Directory";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string currentSearch = ViewBag.CurrentSearch ?? "ALL";
    int pageSize = ViewBag.PageSize ?? 10;
}

<div class="container-fluid py-4" style="max-width: 1400px; margin: 0 auto;">

    <!-- Header & Action Buttons -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="m-0 fw-bold text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Staff Management</h4>
            <p class="text-muted small m-0 mt-1">Manage company staff records, departments, roles, and status.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-success btn-sm px-3 shadow-sm" onclick="exportTableToExcel('staffTable', 'StaffList_Export.xls')">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Excel
            </button>
            <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm" style="background: var(--brand, #1B2430);">
                <i class="bi bi-plus-lg me-1"></i> Add New Staff
            </a>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2 small shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        </div>
    }

    <!-- Filters & Search Toolbar -->
    <div class="card shadow-sm border-0 mb-3 rounded-3">
        <div class="card-body p-3 bg-light rounded-3">
            <div class="row g-3 align-items-center">
                <!-- Global Search -->
                <div class="col-md-4">
                    <div class="input-group input-group-sm shadow-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" id="globalSearch" class="form-control border-start-0 ps-0" placeholder="Search staff (name, email, phone, code)..." onkeyup="filterTable()">
                    </div>
                </div>

                <!-- Status Filter Dropdown -->
                <div class="col-md-2">
                    <select id="filterStatus" class="form-select form-select-sm shadow-sm" onchange="filterTable()">
                        <option value="">All Statuses</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>

                <!-- Department Filter Dropdown -->
                <div class="col-md-2">
                    <select id="filterDepartment" class="form-select form-select-sm shadow-sm" onchange="filterTable()">
                        <option value="">All Departments</option>
                        <option value="IT">IT</option>
                        <option value="HR">HR</option>
                        <option value="Finance">Finance</option>
                        <option value="Operations">Operations</option>
                    </select>
                </div>

                <!-- Role Filter Dropdown -->
                <div class="col-md-2">
                    <select id="filterRole" class="form-select form-select-sm shadow-sm" onchange="filterTable()">
                        <option value="">All Roles</option>
                        <option value="Staff">Staff</option>
                        <option value="Manager">Manager</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

                <div class="col-md-2 text-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm w-100 shadow-sm" onclick="resetFilters()">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table id="staffTable" class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase fs-7 text-nowrap">
                        <tr>
                            <th class="ps-3 cp" onclick="sortTable(0)" style="cursor: pointer;">Staff Code <i class="bi bi-arrow-down-up small text-muted"></i></th>
                            <th class="cp" onclick="sortTable(1)" style="cursor: pointer;">Full Name <i class="bi bi-arrow-down-up small text-muted"></i></th>
                            <th class="cp" onclick="sortTable(2)" style="cursor: pointer;">Email & Phone <i class="bi bi-arrow-down-up small text-muted"></i></th>
                            <th class="cp" onclick="sortTable(3)" style="cursor: pointer;">Department / Title <i class="bi bi-arrow-down-up small text-muted"></i></th>
                            <th class="cp" onclick="sortTable(4)" style="cursor: pointer;">Role <i class="bi bi-arrow-down-up small text-muted"></i></th>
                            <th class="cp" onclick="sortTable(5)" style="cursor: pointer;">Status <i class="bi bi-arrow-down-up small text-muted"></i></th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var staff in Model)
                            {
                                <tr class="staff-row">
                                    <td class="ps-3 fw-semibold text-primary">@staff.StaffCode</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@staff.FullName</div>
                                    </td>
                                    <td>
                                        <div class="small text-dark">@staff.Email</div>
                                        <div class="small text-muted">@staff.Phone</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@(string.IsNullOrEmpty(staff.Department) ? "-" : staff.Department)</div>
                                        <div class="small text-muted">@(string.IsNullOrEmpty(staff.JobTitle) ? "-" : staff.JobTitle)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">@staff.Role</span>
                                    </td>
                                    <td>
                                        <span class="badge @(staff.Status.ToLower() == "active" ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-2 py-1">
                                            @staff.Status
                                        </span>
                                    </td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <a asp-action="Edit" asp-route-id="@staff.Id" class="btn btn-sm btn-outline-primary py-0 px-2 shadow-sm">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox display-6 d-block mb-2 text-secondary"></i>
                                    No staff records found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination Footer -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3 border-top">
                <div class="text-muted small">
                    Showing page <strong>@currentPage</strong> of <strong>@totalPages</strong>
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link shadow-none" asp-action="StaffList" asp-route-pageNumber="@(currentPage - 1)" asp-route-searchText="@currentSearch">Previous</a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link shadow-none" asp-action="StaffList" asp-route-pageNumber="@i" asp-route-searchText="@currentSearch">@i</a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link shadow-none" asp-action="StaffList" asp-route-pageNumber="@(currentPage + 1)" asp-route-searchText="@currentSearch">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // 1. Global Search & Column Filtering logic
        function filterTable() {
            var input = document.getElementById("globalSearch").value.toLowerCase();
            var filterStatus = document.getElementById("filterStatus").value.toLowerCase();
            var filterDepartment = document.getElementById("filterDepartment").value.toLowerCase();
            var filterRole = document.getElementById("filterRole").value.toLowerCase();

            var rows = document.querySelectorAll("#staffTable tbody tr.staff-row");

            rows.forEach(function (row) {
                var textContent = row.textContent.toLowerCase();
                var statusText = row.cells[5].textContent.trim().toLowerCase();
                var deptText = row.cells[3].textContent.trim().toLowerCase();
                var roleText = row.cells[4].textContent.trim().toLowerCase();

                var matchesSearch = textContent.includes(input);
                var matchesStatus = !filterStatus || statusText.includes(filterStatus);
                var matchesDepartment = !filterDepartment || deptText.includes(filterDepartment);
                var matchesRole = !filterRole || roleText.includes(filterRole);

                if (matchesSearch && matchesStatus && matchesDepartment && matchesRole) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        function resetFilters() {
            document.getElementById("globalSearch").value = "";
            document.getElementById("filterStatus").value = "";
            document.getElementById("filterDepartment").value = "";
            document.getElementById("filterRole").value = "";
            filterTable();
        }

        // 2. Column Sorting Script
        function sortTable(n) {
            var table = document.getElementById("staffTable");
            var switching = true, dir = "asc", switchCount = 0;

            while (switching) {
                switching = false;
                var rows = table.rows;

                for (var i = 1; i < (rows.length - 1); i++) {
                    var shouldSwitch = false;
                    var x = rows[i].getElementsByTagName("TD")[n];
                    var y = rows[i + 1].getElementsByTagName("TD")[n];

                    if (!x || !y) continue;

                    var xVal = x.textContent.toLowerCase().trim();
                    var yVal = y.textContent.toLowerCase().trim();

                    if (dir == "asc") {
                        if (xVal > yVal) { shouldSwitch = true; break; }
                    } else if (dir == "desc") {
                        if (xVal < yVal) { shouldSwitch = true; break; }
                    }
                }

                if (shouldSwitch) {
                    rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                    switching = true;
                    switchCount++;
                } else {
                    if (switchCount == 0 && dir == "asc") {
                        dir = "desc";
                        switching = true;
                    }
                }
            }
        }

        // 3. Export Table to Excel Script
        function exportTableToExcel(tableID, filename = '') {
            var downloadLink;
            var dataType = 'application/vnd.ms-excel';
            var tableSelect = document.getElementById(tableID);

            // Clone table to clean actions column before export
            var cloneTable = tableSelect.cloneNode(true);
            var actionHeaders = cloneTable.querySelectorAll('th:last-child, td:last-child');
            actionHeaders.forEach(el => el.remove());

            var tableHTML = cloneTable.outerHTML.replace(/ /g, '%20');

            filename = filename ? filename + '.xls' : 'excel_data.xls';

            downloadLink = document.createElement("a");
            document.body.appendChild(downloadLink);

            if (navigator.msSaveOrOpenBlob) {
                var blob = new Blob(['\ufeff', tableHTML], { type: dataType });
                navigator.msSaveOrOpenBlob(blob, filename);
            } else {
                downloadLink.href = 'data:' + dataType + ', ' + tableHTML;
                downloadLink.download = filename;
                downloadLink.click();
            }
            document.body.removeChild(downloadLink);
        }
    </script>
}