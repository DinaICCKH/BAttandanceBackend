@model BAttendance.Models.StaffViewModel

@{
    ViewData["Title"] = "Onboard New Staff";
}



<div class="container-fluid py-3">
    <div style="max-width: 1200px; margin: 0 auto;" class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left"></i> Back to Staff List</a>
        <h4 class="m-0 mt-2 fw-bold">Onboard New Staff</h4>
    </div>

    <form asp-action="Create" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" style="display:none;"></div>

        <div class="branch-form-grid">
            <!-- Left Column: Personal Information & Organization -->
            <div class="panel-card">
                <div class="panel-body">

                    <div class="panel-section-title mb-2"><i class="bi bi-person-badge"></i> Personal Information</div>
                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label small fw-semibold"></label>
                            <input asp-for="FullName" class="form-control form-control-sm" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StaffCode" class="form-label small fw-semibold"></label>
                            <input asp-for="StaffCode" class="form-control form-control-sm" />
                            <span asp-validation-for="StaffCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label small fw-semibold"></label>
                            <input asp-for="Email" class="form-control form-control-sm" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label small fw-semibold"></label>
                            <input asp-for="Phone" class="form-control form-control-sm" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="NationalId" class="form-label small fw-semibold">National ID</label>
                            <input asp-for="NationalId" class="form-control form-control-sm" />
                            <span asp-validation-for="NationalId" class="text-danger small"></span>
                        </div>
                        <!-- Added Join Date Field -->
                        <div class="col-md-6">
                            <label asp-for="JoinDate" class="form-label small fw-semibold"></label>
                            <input asp-for="JoinDate" type="date" class="form-control form-control-sm" />
                            <span asp-validation-for="JoinDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-3 text-muted" />

                    <div class="panel-section-title mb-2"><i class="bi bi-gear"></i> Organization & Role</div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label small fw-semibold"></label>
                            <input asp-for="Department" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="JobTitle" class="form-label small fw-semibold"></label>
                            <input asp-for="JobTitle" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label small fw-semibold"></label>
                            <select asp-for="Role" class="form-select form-select-sm">
                                <option value="Staff">Staff</option>
                                <option value="Manager">Manager</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HomeBranchId" class="form-label small fw-semibold"></label>
                            <select asp-for="HomeBranchId" class="form-select form-select-sm" asp-items="ViewBag.Branches">
                                <option value="">-- Select Branch --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top text-end">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4 btn-sm">Cancel</a>
                        <button type="submit" class="btn btn-primary btn-brand px-4 ms-2 btn-sm">Create Profile</button>
                    </div>

                </div>
            </div>

            <!-- Right Column: Working Schedule (Sticky Panel) -->
            <div class="staff-sticky-side">
                <div class="panel-card">
                    <div class="panel-body">
                        <div class="panel-section-title mb-2"><i class="bi bi-clock"></i> Working Schedule</div>
                        <div class="text-muted small mb-3">By default, staff follow branch hours unless custom hours are enabled.</div>

                        <!-- Enable Switch -->
                        <div class="mb-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsCustomScheduleEnabled" id="chkCustomSchedule" />
                                <label class="form-check-label small fw-semibold" asp-for="IsCustomScheduleEnabled">Enable Custom Working Hours</label>
                            </div>
                        </div>

                        <!-- Schedule Container (Hidden by default) -->
                        <div id="customScheduleContainer" style="display: none;">
                            <hr class="my-2 text-muted" />
                            <div class="row g-1">
                                @{
                                    var days = new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" };
                                }
                                @foreach (var day in days)
                                {
                                    var isProp = "Is" + day;
                                    var openProp = "OpeningTime" + day;
                                    var closeProp = "ClosingTime" + day;

                                    var isChecked = Model.GetType().GetProperty(isProp)?.GetValue(Model)?.ToString() == "Y";
                                    var openValObj = Model.GetType().GetProperty(openProp)?.GetValue(Model);
                                    var closeValObj = Model.GetType().GetProperty(closeProp)?.GetValue(Model);

                                    var openVal = openValObj is TimeSpan openSpan ? openSpan.ToString(@"hh\:mm") : "08:00";
                                    var closeVal = closeValObj is TimeSpan closeSpan ? closeSpan.ToString(@"hh\:mm") : "17:00";

                                    <div class="col-12 schedule-row py-1 border-bottom border-light">
                                        <div class="row align-items-center g-1">
                                            <div class="col-4">
                                                <input type="hidden" name="@isProp" value="N" />
                                                <div class="form-check mb-0">
                                                    <input class="form-check-input form-check-input-sm" type="checkbox" name="@isProp" value="Y" id="@isProp" @(isChecked ? "checked" : "")>
                                                    <label class="form-check-label small fw-semibold" for="@isProp">@day</label>
                                                </div>
                                            </div>
                                            <div class="col-4">
                                                <input type="time" name="@openProp" class="form-control form-control-sm py-0 px-1" value="@openVal" />
                                            </div>
                                            <div class="col-4">
                                                <input type="time" name="@closeProp" class="form-control form-control-sm py-0 px-1" value="@closeVal" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        document.addEventListener("DOMContentLoaded", function () {
            var chkCustomSchedule = document.getElementById('chkCustomSchedule');
            var customScheduleContainer = document.getElementById('customScheduleContainer');

            function toggleScheduleContainer() {
                if (chkCustomSchedule.checked) {
                    customScheduleContainer.style.display = 'block';
                } else {
                    customScheduleContainer.style.display = 'none';
                }
            }

            // Run on load to handle postback state
            toggleScheduleContainer();

            // Run on change
            chkCustomSchedule.addEventListener('change', toggleScheduleContainer);
        });
    </script>
}