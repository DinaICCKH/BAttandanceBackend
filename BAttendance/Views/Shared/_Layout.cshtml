@using Newtonsoft.Json
@using System.Text
@inject _DbContext _context
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var tokenData = (LoginResult)null;
    var tokenBase64 = HttpContextAccessor.HttpContext.Session.GetString("UserToken");

    if (!string.IsNullOrEmpty(tokenBase64))
    {
        try
        {
            var tokenJson = Encoding.UTF8.GetString(Convert.FromBase64String(tokenBase64));
            tokenData = JsonConvert.DeserializeObject<LoginResult>(tokenJson);
        }
        catch { }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BAttendance</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
    <!-- Put this in the header or top of your view -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/gridstack.js/10.1.2/gridstack.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/gridstack.js/10.1.2/gridstack-extra.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BAttendance.styles.css" asp-append-version="true" />
    <link href="~/css/customstyle.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="~/Picture/BSoftLogo.PNG" />
</head>
<body>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <aside class="app-sidebar" id="appSidebar">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="brand-dot"></span>
            <span>BAttendance</span>
        </a>

        <nav class="nav flex-column">
            <div class="nav-section-label">Overview</div>
            <a class="nav-link" asp-controller="Home" asp-action="Index">
                <i class="bi bi-grid-1x2"></i> <span>Dashboard</span>
            </a>

            <div class="nav-section-label">Manage</div>

            <!-- license key generate -->
            <button class="nav-group-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuLicense" aria-expanded="false">
                <i class="bi bi-building icon-lead"></i> <span>License</span> <i class="bi bi-chevron-right chevron"></i>
            </button>
            <div class="collapse nav-submenu" id="menuLicense">
                <a class="nav-link" asp-controller="License" asp-action="Index"><span>Generate License</span></a>
            </div>

            <!-- Branch group -->
            <button class="nav-group-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuBranch" aria-expanded="false">
                <i class="bi bi-building icon-lead"></i> <span>Branch</span> <i class="bi bi-chevron-right chevron"></i>
            </button>
            <div class="collapse nav-submenu" id="menuBranch">
                <a class="nav-link" asp-controller="Branch" asp-action="Create"><span>Add Branch</span></a>
                <a class="nav-link" asp-controller="Branch" asp-action="Index"><span>Branch List</span></a>
            </div>

            <!-- Staff group -->
            <button class="nav-group-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuStaff" aria-expanded="false">
                <i class="bi bi-people icon-lead"></i> <span>Staff</span> <i class="bi bi-chevron-right chevron"></i>
            </button>
            <div class="collapse nav-submenu" id="menuStaff">
                <a class="nav-link" asp-controller="Staff" asp-action="Create"><span>Add Staff</span></a>
                <a class="nav-link" asp-controller="Staff" asp-action="StaffList"><span>Staff List</span></a>
            </div>

            <!-- User group -->
            <button class="nav-group-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuUser" aria-expanded="false">
                <i class="bi bi-person-badge icon-lead"></i> <span>User</span> <i class="bi bi-chevron-right chevron"></i>
            </button>
            <div class="collapse nav-submenu" id="menuUser">
                <a class="nav-link" asp-controller="User" asp-action="CreateUser"><span>Add User</span></a>
                <a class="nav-link" asp-controller="User" asp-action="UserList"><span>User List</span></a>
            </div>

            <!-- Attendance group -->
            <button class="nav-group-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#menuAttendance" aria-expanded="false">
                <i class="bi bi-calendar-check icon-lead"></i> <span>Attendance</span> <i class="bi bi-chevron-right chevron"></i>
            </button>
            <div class="collapse nav-submenu" id="menuAttendance">
                <a class="nav-link" asp-controller="Attendance" asp-action="Index"><span>Attendance Log</span></a>
                <a class="nav-link" asp-controller="Attendance" asp-action="DailyReport"><span>Daily Report</span></a>
                <a class="nav-link" asp-controller="Attendance" asp-action="MonthlyReport"><span>Monthly Report</span></a>
                <a class="nav-link" asp-controller="Attendance" asp-action="BranchSummary"><span>Branch Summary</span></a>
            </div>
        </nav>

        <div class="sidebar-footer">
            &copy; 2026 BAttendance
        </div>
    </aside>

    <div class="app-main" id="appMain">
        <header class="app-topbar">
            <div class="d-flex align-items-center gap-2">
                <button class="icon-btn" id="sidebarToggle" type="button" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>

            <div class="dropdown">
                <button class="user-menu-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="user-avatar">@(tokenData?.UserName?.Substring(0, 1).ToUpper() ?? "U")</span>
                    <span>@(tokenData?.UserName)</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><span class="dropdown-item-text text-muted small">Signed in as @(tokenData?.UserRole)</span></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline" id="logoutForm">
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </header>

        <main class="app-content" role="main">
            @RenderBody()
        </main>

        <footer class="app-footer">
            BAttendance &middot; <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        var logoutForm = document.getElementById('logoutForm');
        if (logoutForm) {
            logoutForm.addEventListener('submit', function (e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Log out?',
                    text: "You'll need to sign in again to access your account.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, log out',
                    cancelButtonText: 'Cancel',
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#8B93A1',
                    reverseButtons: true
                }).then(function (result) {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("Index", "Login")';
                    }
                });
            });
        }
    </script>

    <script>
        (function () {
            var sidebar = document.getElementById('appSidebar');
            var main = document.getElementById('appMain');
            var backdrop = document.getElementById('sidebarBackdrop');
            var toggle = document.getElementById('sidebarToggle');
            var isMobile = function () { return window.matchMedia('(max-width: 900px)').matches; };

            function openSidebar() {
                if (isMobile()) {
                    sidebar.classList.add('show');
                    backdrop.classList.add('show');
                } else {
                    sidebar.classList.remove('collapsed');
                    main.classList.remove('sidebar-collapsed');
                    localStorage.setItem('sidebarCollapsed', 'false');
                }
            }

            function closeSidebar() {
                if (isMobile()) {
                    sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                } else {
                    sidebar.classList.add('collapsed');
                    main.classList.add('sidebar-collapsed');
                    localStorage.setItem('sidebarCollapsed', 'true');
                }
            }

            if (!isMobile() && localStorage.getItem('sidebarCollapsed') === 'true') {
                sidebar.classList.add('collapsed');
                main.classList.add('sidebar-collapsed');
            }

            if (toggle) {
                toggle.addEventListener('click', function () {
                    var isOpen = isMobile() ? sidebar.classList.contains('show') : !sidebar.classList.contains('collapsed');
                    if (isOpen) { closeSidebar(); } else { openSidebar(); }
                });
            }

            if (backdrop) {
                backdrop.addEventListener('click', closeSidebar);
            }

            var currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll('.nav-submenu .nav-link, .app-sidebar > nav > .nav-link').forEach(function (link) {
                var href = (link.getAttribute('href') || '').toLowerCase();
                if (href && currentPath.indexOf(href) === 0) {
                    link.classList.add('active');
                    var parentSubmenu = link.closest('.nav-submenu');
                    if (parentSubmenu) {
                        parentSubmenu.classList.add('show');
                        var toggleBtn = document.querySelector('[data-bs-target="#' + parentSubmenu.id + '"]');
                        if (toggleBtn) { toggleBtn.setAttribute('aria-expanded', 'true'); }
                    }
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>